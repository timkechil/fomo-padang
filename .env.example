# ---- Supabase (public: safe to ship to the browser) -------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key

# ---- Server only. NEVER prefix with NEXT_PUBLIC_ ---------------------
# Used exclusively by /api/submissions and the seed script.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Salt used to hash submitter IPs for rate limiting (any long random string)
SUBMISSION_IP_SALT=change-me-to-a-long-random-string

# Public site URL, used for canonical + Open Graph URLs
NEXT_PUBLIC_SITE_URL=https://fomopadang.id

# Optional: Cloudflare Turnstile (leave empty to keep CAPTCHA disabled)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
